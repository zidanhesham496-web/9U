# Leave empty for same-origin Vercel Route Handlers (/api/*).
# Set this only when the API is hosted on a separate HTTPS origin.
NEXT_PUBLIC_API_BASE_URL=

# Server-only Vercel variables. Never use NEXT_PUBLIC_ for these values.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-only Supabase variables. Use the service-role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key