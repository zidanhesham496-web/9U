# Leave empty for same-origin Cloudflare Pages Functions (/api/*).
# Set this only when the API is hosted on a separate HTTPS origin.
NEXT_PUBLIC_API_BASE_URL=

# Server-only Cloudflare Pages Function variables.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required only when NEXT_PUBLIC_API_BASE_URL points to another origin.
ALLOWED_ORIGIN=https://your-pages-domain.pages.dev